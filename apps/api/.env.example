# Human auth is owned by Clerk. Do not commit real Clerk keys.
VITASIM_AUTH_PROVIDER=clerk

# Clerk JWT verification. Use the issuer for JWKS verification, or provide
# CLERK_JWT_KEY / CLERK_PEM_PUBLIC_KEY with escaped newlines.
CLERK_JWT_ISSUER=https://your-clerk-instance.clerk.accounts.dev
CLERK_JWKS_URL=
CLERK_JWT_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Backend API key used only to hydrate local user profile fields from Clerk.
CLERK_SECRET_KEY=sk_test_your_own_key
